/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ainu-sources",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-04-29",
	/**
	 * `no_handle_cross_request_promise_resolution` keeps route modules loadable
	 * under concurrency. SvelteKit's generated server manifest reaches each of its
	 * route modules through `__memo(() => import('./nodes/N.js'))`, which memoises
	 * the module-load promise the first time a route is hit. In a fresh isolate that
	 * first hit belongs to one request, and every request arriving at the same route
	 * before the module finishes loading awaits a promise created in a context that
	 * is not its own. Since compatibility date 2024-10-14 the runtime cancels those
	 * continuations and reports "your Worker's code had hung and would never generate
	 * a response", so a burst of traffic against a cold isolate returned 500 for a
	 * share of its requests. The behaviour this restores is scoped to promises that
	 * cross request contexts; the memoised imports carry no request state.
	 */
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_als",
		"no_handle_cross_request_promise_resolution"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Custom domain: db.aynu.org (zone aynu.org must be on this Cloudflare account)
	 */
	"routes": [{ "pattern": "db.aynu.org", "custom_domain": true }],
	/**
	 * Non-secret runtime vars (read via $env/dynamic/private on the Worker).
	 * Secrets (DATABASE_URL, DATABASE_AUTH_TOKEN, BETTER_AUTH_SECRET,
	 * GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, ASSERTION_KEY_SOURCES,
	 * ASSERTION_KEY_MCP,
	 * ACCESS_TEAM_DOMAIN, ACCESS_AUD, ACCESS_SERVICE_TOKENS,
	 * ARCHIVE_CSRF_SECRET, ARCHIVE_ENFORCE_MEMBERSHIP, ARCHIVE_ORIGIN,
	 * ARCHIVE_DAILY_BYTE_LIMIT, ARCHIVE_CONCURRENT_STREAM_LIMIT) are set with
	 * `wrangler secret put`.
	 */
	"vars": {
		"ORIGIN": "https://db.aynu.org"
	},
	"services": [
		{ "binding": "ARCHIVE", "service": "ainu-archive" }
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
